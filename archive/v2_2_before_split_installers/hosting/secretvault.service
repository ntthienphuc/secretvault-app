[Unit]
Description=SecretVault Python encrypted file relay
After=network.target

[Service]
User=secretvault
WorkingDirectory=/opt/secretvault
ExecStart=/opt/secretvault/.venv/bin/python app.py --headless --no-browser --host 127.0.0.1 --port 8765 --behind-proxy --data-dir /var/lib/secretvault
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/secretvault

[Install]
WantedBy=multi-user.target
